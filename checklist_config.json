          "severity": "critical"
        },
        {
          "id": "safe_handling",
          "requirement": "Safe handling & storage instructions",
          "validator": "check_safe_handling",
          "severity": "high"
        },
        {
          "id": "product_identity",
          "requirement": "Clear product name (e.g., 'Plant-Based Deli Slices – Smoked Ham')",
